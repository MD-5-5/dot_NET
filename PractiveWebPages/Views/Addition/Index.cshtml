@model PractiveWebPages.Models.AdditionModel

<h2>Addition</h2>

<form asp-controller="Addition" asp-action="Index" method="post">

    <div>
        <label asp-for="Num1"></label>
        <input asp-for="Num1" />
    </div>

    <br />

    <div>
        <label asp-for="Num2"></label>
        <input asp-for="Num2" />
    </div>

    <br />

    <button type="submit">Add</button>

</form>

@if (ViewBag.Result != null)
{
    <h3>Result: @ViewBag.Result</h3>
}